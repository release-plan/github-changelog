{
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "target": "es2015",
    "module": "ES2022",
    "removeComments": true,
    "allowJs": true,
    "strict": true,
    "lib": ["es2015"],
    "skipLibCheck": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
